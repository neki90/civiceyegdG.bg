
@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@model CivicEyeGD.Pages.Account.RegisterModel

@{
    Layout = "_WelcomeLayout";
    ViewData["Title"] = "Регистрация";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 70vh;">
        <div class="col-12 col-sm-9 col-md-6 col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <a asp-page="/Welcome"
                           class="text-success text-decoration-none fw-bold fs-5">
                            CivicEye <span class="text-dark">GD</span>
                        </a>

                        <h1 class="h3 fw-bold mt-4 mb-2">
                            Създай профил
                        </h1>

                        <p class="text-muted small">
                            Регистрирай се в CivicEye GD.
                        </p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                   class="form-label">
                                Имейл
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label">
                                Парола
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Поне 8 символа" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Потвърди паролата
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Повтори паролата" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            Създай профил
                        </button>
                    </form>

                    <p class="text-center small mt-4 mb-0">
                        Вече имаш профил?
                        <a asp-page="/Account/Login"
                           class="text-success fw-semibold text-decoration-none">
                            Вход
                        </a>
                    </p>

                    <p class="text-center small mt-3 mb-0">
                        <a asp-page="/Welcome"
                           class="text-muted text-decoration-none">
                            ← Обратно към началната страница
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
